<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
    <link rel="preload" href="/styles.css" as="style" />
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/GLOSLogo.png">
    <title>Fields</title>
    
</head>
<body>     
        <%#- include('header', {data: data}); %>
    <header class="header" >
        <div id="pageName" class="headerText">
            Fields
            <br>
            <br>
            <button style="font-size: 100%; width: 20vw;" class="itemFormat primaryStyle primaryBorder" onclick="window.location.href = window.location.href.replace(/\?/g, '') +'/new';" >New Field</button>
        </div>
    </header>
        <div id="innerBody"  style= "<%= data.page.includes('activeGame') ? "background-image: linear-gradient(90deg, black 48%, silver 50%, black 52%)": ""%>">
            <div id="content">
                <%#- include('bodyColumns',{data: data}); %>
                <div id="<%= %>" class="singleColumn">
                    <%#- include('list', {data: data}); %>
                    <% for(let i=0; i< data.list.length; i++) {%>
                        <%- include('field_item',{item: data.list[i]}); %>
                    <% } %>
                </div>
            </div>
        </div>
        <%- include('footer', {data: data}); %>
        <div id="formBackground" style="display: none; touch-action: none;" onclick="closeForm()"></div>
        
        <script src="/main.js" ></script>
        
</body>
</html>