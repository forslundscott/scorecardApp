<!DOCTYPE html>
<html lang="en">
<head>
</head>
<body>
  <%- include('managementForm'); %>
  <footer class="footer">
    
    <div class="triColumn textCenter">
      <!-- <div class="statButton"> -->
        <form action="/games" method="get" class="navButton">
          <button type="submit" class="navButton" >Games</button>
        </form>
      
      <!-- </div> -->
    </div>

    <div class="triColumn textCenter" ><img src="/GLOSLogo.png" alt="GLOS Logo" id="mainLogo" onclick="toggleForm(document.getElementById('managementForm'),document.getElementById('formBackground'))"></div>
    <div class="triColumn textCenter">
      <% if (data.user == undefined) { %>
        <form action="/auth/login" method="get" class="navButton">
          <button type="submit" class="navButton">Log In</button>
        </form>
      <% } else { %>
        <form action="/auth/logout" method="POST" class="navButton">
          <button id="logoutBtn" type="button" class="navButton">Log Out</button>
        </form>
      <% } %>
          
      </div>
    <script>
      document.getElementById('logoutBtn').addEventListener('click', async () => {

          const response = await fetch(
              '/auth/logout',
              {
                  method: 'POST',
                  credentials: 'include'
              }
          );

          if (response.ok) {
              window.location.reload();
          }
      });
    </script>
  </footer>
</html>