<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
    <link rel="preload" href="/styles.css" as="style" />
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/GLOSLogo.png">
    <title>New Field</title>
    
</head>
<body>
    
        
        <header class="header" >
        <div id="pageName" class="headerText">
                <br>
            New Field
            <br>
            <br>
            
        </div>
    </header>
        <div id="innerBody"  style= "<%= data.page.includes('activeGame') ? "background-image: linear-gradient(90deg, black 48%, silver 50%, black 52%)": ""%>">
            <div id="content">
                <%#- include('bodyColumns',{data: data}); %>
                <div id="<%= %>" class="singleColumn">
                    <form id="newFieldForm" class="textCenter" action="add" onsubmit="confirmSubmit(event)" method="post" style="display: ''; text-align: center;">
                        
                        
                        <br>
                        <input type="text" name="fieldName" value="" placeholder="Field Name" required>
                            <br><br>
                            
                            <select name="fieldType" id="" required>
                                <option value="" disabled selected>Field Type</option>
                                <option value="Court">Court</option>
                                <option value="Field">Field</option>
                            </select>
                            <br>
                            
                            
                            
                            <br>
                            <br>
                            <button type="submit" class="primaryStyle primaryBorder" style="font-weight: bold; width: auto; height: 5vh;">Add Field</button>
                    </form>
                </div>
            </div>
        </div>
        <%- include('footer', {data: data}); %>
        <div id="formBackground" style="display: none; touch-action: none;" onclick="closeForm()"></div>
            
        
        <script src="/main.js" ></script>
        
</body>
</html>
    
    
    

